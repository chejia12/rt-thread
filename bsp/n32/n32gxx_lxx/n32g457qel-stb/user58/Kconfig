menu "user driber of 58"
	# NOR Flash+DFS
 	config BRD_DFS_NOR_FLASH
        bool "Enable IN NOR FLASH MOUNT DFS elm or lfs"
        default n
		depends on RT_USING_DFS#正向依赖RT_USING_DFS没有定义这个都不显示
		depends on RT_USING_SFUD#正向依赖RT_USING_SFUD
		depends on RT_USING_DFS_ELMFAT || PKG_USING_LITTLEFS#依赖一种一个定义
        if BRD_DFS_NOR_FLASH
            config SFUD_NOR_FLASH_ATTACH_SPI_BUS
                string "Select the SPI bus connected to the NOR flash"
                default "spi1"
			config SPI_CS_NO_FLASH
				int "select spi cs pin"
				range 0 112
				default 4
            config SFUD_NOR_FLASH_NAME
                string "Set NOR flash block device name"
                default "spi11"
			
        endif
	#HT530 12bit dac
	config BRD_DAC_HT5320
        bool "Enable DAC HT530"
        default n
		depends on RT_USING_SPI
		if BRD_DAC_HT5320
			config BRD_DAC_HT5320_SPI_BUS
                string "select spi  bus of attach nor flash"
                default "spi2"
			config BRD_DAC_HT5320_CH0
				int "select chanel 0  cs pin "
				range 0 112
				default 4
			config BRD_DAC_HT5320_CH1
				int "select chanel 1  cs pin "
				range 0 112
				default 5
			config BRD_DAC_HT5320_CH2
				int "select chanel 2  cs pin "
				range 0 112
				default 6
			config BRD_DAC_HT5320_CH3
				int "select chanel 3  cs pin "
				range 0 112
				default 7
		endif
	#北斗解析库
